PORT=3000
# Bearer token your frontend / tools send to the /api routes
API_TOKEN=change_me
DB_PATH=./siap-inbox.db

# Meta WhatsApp Cloud API
WA_VERIFY_TOKEN=any_string_you_set_in_meta_webhook_config
